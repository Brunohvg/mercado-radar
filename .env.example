DATABASE_URL=postgresql://mercado_radar:mercado_radar@localhost:5432/mercado_radar?schema=public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segurança: criptografia dos tokens e assinatura da sessão administrativa.
APP_ENCRYPTION_KEY=

# Login administrativo do painel web.
ADMIN_EMAIL=
# Hash bcrypt (não coloque senha em texto puro).
ADMIN_PASSWORD_HASH=

# Mercado Livre OAuth
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=http://localhost:3000/api/integrations/mercadolivre/callback

# Protege o endpoint de monitoramento automático.
RADAR_CRON_SECRET=

# Opcional: chave dedicada para assinar tokens da extensão.
# Se vazia, o backend usa APP_ENCRYPTION_KEY.
RADAR_EXTENSION_SIGNING_KEY=

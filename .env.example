DATABASE_URL=postgresql://mercado_radar:mercado_radar@localhost:5432/mercado_radar?schema=public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segurança para criptografar tokens de integrações.
APP_ENCRYPTION_KEY=

# Mercado Livre OAuth
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=http://localhost:3000/api/integrations/mercadolivre/callback


# OBSOLETA: a extensão agora autentica por token de dispositivo (/api/extension/auth/*).
# Nenhum código lê esta variável; pode ser removida do ambiente.
RADAR_EXTENSION_API_KEY=


# Protege o endpoint de monitoramento automático.
# Use uma chave diferente da extensão.
RADAR_CRON_SECRET=


# Login do painel web (obrigatório em produção; sem isto o painel fica trancado).
# Gere com:  node scripts/hash-password.mjs "uma-senha-forte-com-10+-caracteres"
# (o hash usa ':' e não '$' de propósito, porque Docker Compose/Coolify interpolam '$')
ADMIN_EMAIL=
# Aceita scrypt (script acima) ou bcrypt ($2a/$2b — cuidado com "$" no Coolify/Compose).
ADMIN_PASSWORD_HASH=
# Opcional: se vazio, o cookie é assinado com APP_ENCRYPTION_KEY.
ADMIN_SESSION_SECRET=

# Opcional: fixa a conta do Mercado Livre usada pelo painel (id da tabela MercadoLivreAccount).
ADMIN_ML_ACCOUNT_ID=

# Opcional: máximo de chamadas simultâneas ao Mercado Livre (padrão 6).
ML_MAX_CONCURRENCY=6

# Opcional: chave dedicada para assinar tokens da extensão (padrão: APP_ENCRYPTION_KEY).
RADAR_EXTENSION_SIGNING_KEY=

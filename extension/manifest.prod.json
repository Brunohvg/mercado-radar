{
  "manifest_version": 3,
  "name": "Mercado Radar",
  "version": "0.10.0",
  "description": "Análise na busca e no produto, comparação de anúncios e calculadora de lucro com origem dos dados.",
  "permissions": ["storage", "sidePanel", "identity"],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://radar.optarys.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.mercadolivre.com.br/*"],
      "exclude_matches": [
        "https://developers.mercadolivre.com.br/*",
        "https://*.mercadolivre.com.br/captcha/*",
        "https://*.mercadolivre.com.br/jms/*",
        "https://*.mercadolivre.com.br/gz/*"
      ],
      "js": [
        "selectors.js",
        "panel-model.js",
        "product-analysis.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Abrir Mercado Radar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116"
}

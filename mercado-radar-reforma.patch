+button.secondary { background: var(--surface-2); color: var(--text-2); border: 1px solid var(--line-strong); }
+button.secondary:hover { background: var(--line); }
+
+.error {
+  padding: 10px 12px; border-radius: var(--r-md);
+  background: var(--risk-bg); color: var(--risk); font-size: 12px;
+}
+
+.market-range { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
+.market-range > div { padding: 8px; border-radius: var(--r-md); background: var(--surface-2); }
+.market-range small { display: block; color: var(--text-3); font-size: 10px; font-weight: 650; }
+.market-range strong { display: block; margin-top: 3px; font-size: 14px; }
+
+.competitor-row {
+  display: flex; justify-content: space-between; gap: 8px;
+  padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 12px;
+}
+.competitor-row > div:first-child { min-width: 0; flex: 1; }
+.competitor-row > div:last-child { flex: 0 0 auto; text-align: right; }
+.competitor-row span, .competitor-row small, .competitor-row strong { display: block; }
+.competitor-row span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.competitor-row small { margin-top: 2px; color: var(--text-3); font-size: 11px; }
+.mercado-radar-trend { padding: 6px 0; border-bottom: 1px solid var(--line); font-size: 12px; }
+
+.compare-box {
+  margin-top: 10px; padding: 12px; border-radius: var(--r-md);
+  background: var(--brand-50); border: 1px solid var(--line); font-size: 12px;
+}
+
+.auth-card { background: var(--brand-50); }
+.auth-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
+.auth-copy { min-width: 0; }
+.auth-copy strong, .auth-copy small { display: block; }
+.auth-copy strong { font-size: 14px; }
+.auth-copy small { margin-top: 3px; color: var(--text-3); font-size: 11px; }
+.auth-dot {
+  width: 9px; height: 9px; flex: 0 0 auto; border-radius: 50%;
+  background: var(--line-strong);
+}
+.auth-dot.online { background: var(--ok); box-shadow: 0 0 0 4px rgba(24, 150, 122, 0.15); }
+.auth-actions { display: grid; grid-template-columns: 1fr auto; gap: 8px; margin-top: 10px; }
+.auth-actions button { margin-top: 0; }
+.auth-actions .secondary { width: auto; }
+#logoutButton[hidden] { display: none; }

@@ -0,0 +1,108 @@
+/* Mercado Radar — Side Panel (usa os mesmos tokens da UI injetada) */
+* { box-sizing: border-box; }
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--text);
+  font-family: var(--font);
+  font-size: 13px;
+  line-height: 1.45;
+  -webkit-font-smoothing: antialiased;
+}
+main { padding: 16px; }
+:focus-visible { outline: 2px solid var(--brand-500); outline-offset: 2px; }
+[hidden] { display: none !important; }
+
+.brand { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
+.brand-copy { display: flex; align-items: center; gap: 10px; min-width: 0; }
+.brand-copy img { width: 34px; height: 34px; border-radius: 9px; }
+.brand-copy strong { display: block; font-size: 16px; line-height: 1.1; letter-spacing: -0.02em; }
+.brand-copy small {
+  display: block; margin-top: 3px; color: var(--text-3);
+  font-size: 10px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
+}
+.pill {
+  padding: 3px 9px; border-radius: var(--r-pill);
+  background: var(--brand-100); color: var(--brand-600);
+  font-size: 10px; font-weight: 800;
+}
+
+.card {
+  margin-bottom: 12px; padding: 14px;
+  border: 1px solid var(--line); border-radius: var(--r-lg);
+  background: var(--surface); box-shadow: var(--shadow-1);
+}
+.title { margin-bottom: 9px; font-size: 13px; font-weight: 750; color: var(--text); }
+.product-title { margin-bottom: 9px; font-size: 14px; font-weight: 700; line-height: 1.4; }
+.muted { color: var(--text-3); font-size: 12px; line-height: 1.5; }
+.good { color: var(--brand-600); }
+.bad { color: var(--risk); }
+.divider { height: 1px; margin: 12px 0; background: var(--line); }
+
+.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
+.metric { padding: 10px; border-radius: var(--r-md); background: var(--surface-2); min-width: 0; }
+.metric small {
+  display: block; color: var(--text-3); font-size: 10px; font-weight: 650;
+  text-transform: uppercase; letter-spacing: 0.02em;
+}
+.metric strong { display: block; margin-top: 3px; font-size: 16px; letter-spacing: -0.01em; }
+.metric span.muted { display: block; margin-top: 4px; }
+
+label { display: block; margin: 10px 0 5px; font-size: 12px; font-weight: 650; color: var(--text-2); }
+input {
+  width: 100%; min-height: 36px; padding: 0 10px;
+  border: 1px solid var(--line-strong); border-radius: var(--r-sm);
+  background: var(--surface); font: inherit; color: inherit;
+}
+button {
+  width: 100%; min-height: 38px; margin-top: 11px; padding: 0 14px;
+  border: 0; border-radius: var(--r-md);
+  background: var(--brand-500); color: #fff;
+  font: inherit; font-weight: 650; cursor: pointer;
+}
+button:hover { background: var(--brand-600); }

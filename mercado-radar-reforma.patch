+/* Mercado Radar — UI injetada no Mercado Livre (vive dentro de Shadow DOM) */
+.rr {
+  box-sizing: border-box;
+  font-family: var(--font);
+  font-size: 13px;
+  line-height: 1.45;
+  color: var(--text);
+  -webkit-font-smoothing: antialiased;
+  text-align: left;
+}
+.rr *,
+.rr *::before,
+.rr *::after {
+  box-sizing: border-box;
+}
+.rr button,
+.rr input,
+.rr select {
+  font: inherit;
+  color: inherit;
+}
+.rr :focus-visible {
+  outline: 2px solid var(--brand-500);
+  outline-offset: 2px;
+}
+.rr [hidden] {
+  display: none !important;
+}
+
+/* ---------- marca ---------- */
+.rr .brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-weight: 700;
+  color: var(--brand-600);
+  letter-spacing: -0.01em;
+}
+.rr .brand svg {
+  width: 16px;
+  height: 16px;
+}
+
+/* ---------- chips e botões ---------- */
+.rr .chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 2px 8px;
+  border-radius: var(--r-pill);
+  font-size: 11px;
+  font-weight: 700;
+  line-height: 1.5;
+  background: var(--surface-2);
+  color: var(--text-2);
+  white-space: nowrap;
+}
+.rr .chip--ok { background: var(--ok-bg); color: var(--brand-600); }
+.rr .chip--warn { background: var(--warn-bg); color: var(--warn); }
+.rr .chip--risk { background: var(--risk-bg); color: var(--risk); }
+.rr .chip--info { background: var(--info-bg); color: var(--info); }
+
+.rr .btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  min-height: 36px;
+  padding: 0 14px;
+  border: 1px solid transparent;
+  border-radius: var(--r-md);
+  background: var(--brand-500);
+  color: #fff;
+  font-weight: 650;
+  cursor: pointer;
+  transition: background 0.15s;
+}
+.rr .btn:hover { background: var(--brand-600); }
+.rr .btn:disabled { opacity: 0.6; cursor: default; }
+.rr .btn--ghost {
+  background: transparent;
+  border-color: var(--line-strong);
+  color: var(--text-2);
+}
+.rr .btn--ghost:hover { background: var(--surface-2); }
+.rr .btn--block { width: 100%; }
+.rr .link {
+  border: 0;
+  background: none;
+  padding: 0;
+  color: var(--brand-600);
+  font-weight: 650;
+  cursor: pointer;
+}
+
+.rr .field { display: block; margin-top: 10px; }
+.rr .field > span {
+  display: block;
+  margin-bottom: 4px;
+  font-size: 12px;
+  font-weight: 650;
+  color: var(--text-2);
+}
+.rr select,
+.rr input[type="number"],
+.rr input[type="text"] {
+  width: 100%;
+  min-height: 36px;
+  padding: 0 10px;
+  border: 1px solid var(--line-strong);
+  border-radius: var(--r-sm);
+  background: var(--surface);
+}
+.rr select:disabled { opacity: 0.55; }
+.rr .check {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-top: 10px;
+  font-weight: 500;
+}
+.rr .muted { color: var(--text-3); font-size: 12px; }
+.rr .est { color: var(--text-3); font-weight: 600; }
+
+/* ---------- faixa sob o card da busca ---------- */
+.rr .strip {
+  margin: 8px 0 0;
+  padding: 8px 10px 9px;
+  border: 1px solid var(--line);
+  border-radius: var(--r-md);
+  background: var(--surface);
+  box-shadow: var(--shadow-1);
+}
+.rr .strip__head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  margin-bottom: 6px;
+  font-size: 12px;
+}
+.rr .strip__grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 6px;
+}
+.rr .stat { min-width: 0; }
+.rr .stat small {
+  display: block;
+  font-size: 10px;
+  font-weight: 650;
+  letter-spacing: 0.02em;
+  text-transform: uppercase;
+  color: var(--text-3);
+}
+.rr .stat b {
+  display: block;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: 13px;
+  font-weight: 700;
+  color: var(--text);
+}
+.rr .stat b.ok { color: var(--brand-600); }
+.rr .stat b.warn { color: var(--warn); }
+.rr .stat b.risk { color: var(--risk); }
+.rr .strip__mine {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  margin-top: 7px;
+  padding-top: 7px;
+  border-top: 1px dashed var(--line-strong);
+  font-size: 12px;
+}
+.rr .strip__foot {
+  margin-top: 6px;
+  font-size: 10px;
+  color: var(--text-3);
+}
+
+/* ---------- painel de filtros ---------- */
+.rr .panel {
+  width: 100%;
+  margin-bottom: 14px;
+  border: 1px solid var(--line);
+  border-radius: var(--r-lg);
+  background: var(--surface);
+  box-shadow: var(--shadow-2);
+  overflow: hidden;
+}
+.rr .panel__head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 12px 14px;
+  border-bottom: 1px solid var(--line);
+}
+.rr .panel__head .brand { font-size: 15px; }
+.rr .panel__count { font-size: 12px; color: var(--text-3); }
+.rr .panel__body { padding: 4px 14px 14px; }
+.rr .notice {
+  margin: 12px 14px 0;
+  padding: 10px 12px;
+  border-radius: var(--r-md);
+  font-size: 12px;
+  background: var(--info-bg);
+  color: var(--info);
+}
+.rr .notice--risk { background: var(--risk-bg); color: var(--risk); }
+.rr .notice--warn { background: var(--warn-bg); color: var(--warn); }
+.rr .notice .btn { margin-top: 8px; min-height: 32px; }
+.rr details.sec { border-bottom: 1px solid var(--line); padding: 2px 0 10px; }
+.rr details.sec:last-of-type { border-bottom: 0; }
+.rr details.sec > summary {
+  cursor: pointer;
+  list-style: none;
+  padding: 10px 0 2px;
+  font-size: 12px;
+  font-weight: 750;
+  letter-spacing: 0.03em;
+  text-transform: uppercase;
+  color: var(--text-2);
+}
+.rr details.sec > summary::-webkit-details-marker { display: none; }
+.rr details.sec > summary::after { content: "▾"; float: right; color: var(--text-3); }
+.rr details.sec:not([open]) > summary::after { content: "▸"; }
+.rr .mine-box {
+  margin-top: 10px;
+  padding: 10px;
+  border: 1px solid var(--line);
+  border-radius: var(--r-md);
+  background: var(--brand-50);
+}
+.rr .mine-box small { display: block; margin-top: 6px; color: var(--text-3); font-size: 11px; }
+
+/* ---------- widget do anúncio ---------- */
+.rr .widget {
+  margin: 12px 0;
+  border: 1px solid var(--line);
+  border-radius: var(--r-lg);
+  background: var(--surface);
+  box-shadow: var(--shadow-2);
+  overflow: hidden;
+}
+.rr .widget--floating {
+  position: fixed;
+  right: 20px;
+  bottom: 84px;
+  width: 340px;
+  max-height: calc(100vh - 120px);
+  overflow: auto;
+  z-index: 2147483000;
+}
+.rr .widget__head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 12px 14px;
+  cursor: pointer;
+}
+.rr .widget__head .brand { font-size: 14px; }
+.rr .widget__body { padding: 0 14px 14px; }
+.rr .kpis {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 8px;
+}
+.rr .kpi {
+  padding: 8px;
+  border-radius: var(--r-md);
+  background: var(--surface-2);
+  min-width: 0;
+}
+.rr .kpi small {
+  display: block;
+  font-size: 10px;
+  font-weight: 650;
+  text-transform: uppercase;
+  letter-spacing: 0.02em;
+  color: var(--text-3);
+}
+.rr .kpi b {
+  display: block;
+  margin-top: 2px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: 15px;
+  letter-spacing: -0.01em;
+}
+.rr .kpi b.ok { color: var(--brand-600); }
+.rr .kpi b.warn { color: var(--warn); }
+.rr .kpi b.risk { color: var(--risk); }
+
+.rr .block { margin-top: 14px; }
+.rr .block__title {
+  margin-bottom: 6px;
+  font-size: 12px;
+  font-weight: 750;
+  text-transform: uppercase;
+  letter-spacing: 0.03em;
+  color: var(--text-2);
+}
+.rr .payout .line {
+  display: flex;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 5px 0;
+  border-bottom: 1px dashed var(--line);
+  font-size: 13px;
+}
+.rr .payout .line span:first-child { color: var(--text-2); }
+.rr .payout .line.neg b { color: var(--risk); }
+.rr .payout .line.total {
+  margin-top: 4px;
+  padding: 8px 10px;
+  border: 0;
+  border-radius: var(--r-md);
+  background: var(--brand-50);
+  font-size: 14px;
+  font-weight: 700;
+}
+.rr .payout .line.total.risk { background: var(--risk-bg); }
+.rr .cost-row { display: flex; gap: 8px; margin-top: 10px; }
+.rr .cost-row input { flex: 1; }
+.rr .rows .row {
+  display: flex;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 5px 0;
+  font-size: 12px;
+}
+.rr .rows .row span:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.rr .skeleton {
+  height: 14px;
+  margin: 8px 0;
+  border-radius: 6px;
+  background: linear-gradient(90deg, var(--surface-2), var(--line), var(--surface-2));
+  background-size: 200% 100%;
+  animation: rr-shimmer 1.3s infinite linear;
+}
+@keyframes rr-shimmer {
+  from { background-position: 200% 0; }
+  to { background-position: -200% 0; }
+}
+
+/* ---------- lançador e menu ---------- */
+.rr .launcher {

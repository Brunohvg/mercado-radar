generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingType {
  CLASSIC
  PREMIUM
}

enum AnalysisVerdict {
  GOOD
  TIGHT
  BAD
  KIT_ONLY
  REPRICE
}

model AppSettings {
  id                    String   @id @default("default")
  bibeloDiscountPercent Decimal  @default(35) @db.Decimal(5, 2)
  targetMarginPercent   Decimal  @default(20) @db.Decimal(5, 2)
  targetRoiPercent      Decimal  @default(30) @db.Decimal(5, 2)
  operatingCostDefault  Decimal  @default(1) @db.Decimal(10, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Product {
  id                    String            @id @default(cuid())
  name                  String
  sku                   String?           @unique
  supplier              String            @default("Bibelô")
  supplierPrice         Decimal           @db.Decimal(12, 2)
  discountPercent       Decimal           @default(35) @db.Decimal(5, 2)
  weightGrams           Int?
  widthCm               Decimal?          @db.Decimal(8, 2)
  heightCm              Decimal?          @db.Decimal(8, 2)
  lengthCm              Decimal?          @db.Decimal(8, 2)
  active                Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  analyses              ProductAnalysis[]

  @@index([createdAt])
  @@index([active])
}

model ProductAnalysis {
  id                    String            @id @default(cuid())
  productId             String?
  productName           String
  listingType           ListingType       @default(CLASSIC)
  kitQuantity           Int               @default(1)
  supplierPrice         Decimal           @db.Decimal(12, 2)
  discountPercent       Decimal           @db.Decimal(5, 2)
  unitCost              Decimal           @db.Decimal(12, 2)
  purchaseCost          Decimal           @db.Decimal(12, 2)
  salePrice             Decimal           @db.Decimal(12, 2)
  commissionPercent     Decimal           @db.Decimal(5, 2)
  commissionAmount      Decimal           @db.Decimal(12, 2)
  fixedFee              Decimal           @default(0) @db.Decimal(12, 2)
  shippingCost          Decimal           @default(0) @db.Decimal(12, 2)
  operatingCost         Decimal           @default(0) @db.Decimal(12, 2)
  amountReceived        Decimal           @db.Decimal(12, 2)
  profit                Decimal           @db.Decimal(12, 2)
  marginPercent         Decimal           @db.Decimal(7, 2)
  roiPercent            Decimal           @db.Decimal(7, 2)
  targetMarginPercent   Decimal           @db.Decimal(5, 2)
  targetRoiPercent      Decimal           @db.Decimal(5, 2)
  minimumSuggestedPrice Decimal           @db.Decimal(12, 2)
  verdict               AnalysisVerdict
  source                String            @default("MANUAL")
  metadata              Json?
  createdAt             DateTime          @default(now())
  product               Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([verdict, createdAt])
}

model MercadoLivreAccount {
  id                    String   @id @default(cuid())
  mercadoLivreUserId    String   @unique
  nickname              String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenExpiresAt        DateTime
  scopes                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SyncRun {
  id          String   @id @default(cuid())
  kind        String
  status      String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  itemsRead   Int      @default(0)
  itemsSaved  Int      @default(0)
  error       String?
  metadata    Json?

  @@index([kind, startedAt])
}

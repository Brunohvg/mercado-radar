generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingType {
  CLASSIC
  PREMIUM
}

enum AnalysisVerdict {
  GOOD
  TIGHT
  BAD
  KIT_ONLY
  REPRICE
}

model AppSettings {
  id                    String   @id @default("default")
  defaultDiscountPercent Decimal  @default(0) @db.Decimal(5, 2)
  targetMarginPercent   Decimal  @default(20) @db.Decimal(5, 2)
  targetRoiPercent      Decimal  @default(30) @db.Decimal(5, 2)
  operatingCostDefault  Decimal  @default(1) @db.Decimal(10, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Product {
  id                    String            @id @default(cuid())
  name                  String
  sku                   String?           @unique
  supplier              String?
  supplierPrice         Decimal           @db.Decimal(12, 2)
  discountPercent       Decimal           @default(0) @db.Decimal(5, 2)
  weightGrams           Int?
  widthCm               Decimal?          @db.Decimal(8, 2)
  heightCm              Decimal?          @db.Decimal(8, 2)
  lengthCm              Decimal?          @db.Decimal(8, 2)
  active                Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  analyses              ProductAnalysis[]

  @@index([createdAt])
  @@index([active])
}

model ProductAnalysis {
  id                    String            @id @default(cuid())
  productId             String?
  productName           String
  listingType           ListingType       @default(CLASSIC)
  kitQuantity           Int               @default(1)
  supplierPrice         Decimal           @db.Decimal(12, 2)
  discountPercent       Decimal           @db.Decimal(5, 2)
  unitCost              Decimal           @db.Decimal(12, 2)
  purchaseCost          Decimal           @db.Decimal(12, 2)
  salePrice             Decimal           @db.Decimal(12, 2)
  commissionPercent     Decimal           @db.Decimal(5, 2)
  commissionAmount      Decimal           @db.Decimal(12, 2)
  fixedFee              Decimal           @default(0) @db.Decimal(12, 2)
  shippingCost          Decimal           @default(0) @db.Decimal(12, 2)
  operatingCost         Decimal           @default(0) @db.Decimal(12, 2)
  amountReceived        Decimal           @db.Decimal(12, 2)
  profit                Decimal           @db.Decimal(12, 2)
  marginPercent         Decimal           @db.Decimal(7, 2)
  roiPercent            Decimal           @db.Decimal(7, 2)
  targetMarginPercent   Decimal           @db.Decimal(5, 2)
  targetRoiPercent      Decimal           @db.Decimal(5, 2)
  minimumSuggestedPrice Decimal           @db.Decimal(12, 2)
  verdict               AnalysisVerdict
  source                String            @default("MANUAL")
  metadata              Json?
  createdAt             DateTime          @default(now())
  product               Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([verdict, createdAt])
}

model MercadoLivreAccount {
  id                    String   @id @default(cuid())
  mercadoLivreUserId    String   @unique
  nickname              String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenExpiresAt        DateTime
  scopes                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SyncRun {
  id          String   @id @default(cuid())
  kind        String
  status      String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  itemsRead   Int      @default(0)
  itemsSaved  Int      @default(0)
  error       String?
  metadata    Json?

  @@index([kind, startedAt])
}


model MercadoLivreNotification {
  id            String    @id @default(cuid())
  externalId    String?   @unique
  topic         String
  resource      String
  userId        String
  applicationId String?
  attempts      Int       @default(1)
  sentAt        DateTime?
  receivedAt    DateTime?
  payload       Json
  status        String    @default("PENDING")
  processedAt   DateTime?
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([topic, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}


model MarketSnapshot {
  id                String   @id @default(cuid())
  sellerUserId      String
  query             String
  categoryId        String?
  resultCount       Int
  minimumPrice      Decimal? @db.Decimal(12, 2)
  p25Price          Decimal? @db.Decimal(12, 2)
  medianPrice       Decimal? @db.Decimal(12, 2)
  p75Price          Decimal? @db.Decimal(12, 2)
  maximumPrice      Decimal? @db.Decimal(12, 2)
  averagePrice      Decimal? @db.Decimal(12, 2)
  testedPrice       Decimal? @db.Decimal(12, 2)
  marketGapPercent  Decimal? @db.Decimal(8, 2)
  opportunityScore  Int?
  verdict           String?
  competitors       Json
  createdAt         DateTime @default(now())

  @@index([sellerUserId, createdAt])
  @@index([categoryId, createdAt])
  @@index([verdict, createdAt])
}


model MercadoLivreProduct {
  id                String   @id @default(cuid())
  mlItemId          String   @unique
  sellerUserId      String
  title             String
  sku               String?
  categoryId        String?
  status            String
  listingTypeId     String?
  currentPrice      Decimal? @db.Decimal(12, 2)
  availableQuantity Int      @default(0)
  soldQuantity      Int      @default(0)
  visitsTotal       Int?
  permalink         String?
  thumbnail         String?
  freeShipping      Boolean  @default(false)
  supplier           String?
  supplierPrice      Decimal? @db.Decimal(12, 2)
  discountPercent    Decimal  @default(0) @db.Decimal(5, 2)
  raw               Json
  lastSyncedAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sellerUserId, status])
  @@index([sellerUserId, soldQuantity])
  @@index([lastSyncedAt])
}

model MercadoLivreOrder {
  id                  String                    @id @default(cuid())
  mlOrderId           String                    @unique
  sellerUserId        String
  status              String
  dateCreated         DateTime
  dateClosed          DateTime?
  currencyId          String                    @default("BRL")
  totalAmount         Decimal                   @default(0) @db.Decimal(12, 2)
  paidAmount          Decimal                   @default(0) @db.Decimal(12, 2)
  marketplaceFeeTotal Decimal?                  @db.Decimal(12, 2)
  shippingId          String?
  shippingCost        Decimal?                  @db.Decimal(12, 2)
  buyerNickname       String?
  profit              Decimal?                  @db.Decimal(12, 2)
  marginPercent       Decimal?                  @db.Decimal(8, 2)
  profitabilityStatus String                    @default("AWAITING_COST")
  raw                 Json
  lastSyncedAt        DateTime                  @default(now())
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  items               MercadoLivreOrderItem[]

  @@index([sellerUserId, dateCreated])
  @@index([status, dateCreated])
  @@index([profitabilityStatus, dateCreated])
}

model MercadoLivreOrderItem {
  id             String              @id @default(cuid())
  externalKey    String              @unique
  orderId        String
  mlItemId       String
  variationId    String?
  title          String
  sku            String?
  quantity       Int
  unitPrice      Decimal             @db.Decimal(12, 2)
  saleFee        Decimal?            @db.Decimal(12, 2)
  listingTypeId  String?
  unitCost       Decimal?            @db.Decimal(12, 2)
  profit         Decimal?            @db.Decimal(12, 2)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  order          MercadoLivreOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([mlItemId])
  @@index([sku])
}
